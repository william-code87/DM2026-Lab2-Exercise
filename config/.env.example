# Who you are. Both are recorded in your encrypted session logs, which is
# how a submission is matched to you. They go here rather than into a
# notebook cell because this file is git-ignored: your student ID never
# enters a notebook, an output, or anything you push to GitHub. Use your
# name as it should appear on the submission, and your real student ID.
STUDENT_NAME = "your name"
STUDENT_ID = "your student id"

GOOGLE_API_KEY = "your-google-api-key"
GROQ_API_KEY = "your-groq-api-key"

# If a backend gives you more than one key (a free Gemini account can
# generate several, each with its own separate rate limit), list them as
# GOOGLE_API_KEY_1, GOOGLE_API_KEY_2, and so on instead of the single
# GOOGLE_API_KEY above -- the notebook rotates to the next one whenever
# the current one hits its rate limit. Uncomment and fill in as many as
# you have, up to ten; you don't need all ten to benefit from this. The
# same numbered pattern works for GROQ_API_KEY_1, GROQ_API_KEY_2, ... too,
# if you ever have more than one Groq key -- not just Gemini.
# GOOGLE_API_KEY_1 = "your-first-google-api-key"
# GOOGLE_API_KEY_2 = "your-second-google-api-key"
# GOOGLE_API_KEY_3 = "your-third-google-api-key"
# GOOGLE_API_KEY_4 = "your-fourth-google-api-key"
# GOOGLE_API_KEY_5 = "your-fifth-google-api-key"
# GOOGLE_API_KEY_6 = "your-sixth-google-api-key"
# GOOGLE_API_KEY_7 = "your-seventh-google-api-key"
# GOOGLE_API_KEY_8 = "your-eighth-google-api-key"
# GOOGLE_API_KEY_9 = "your-ninth-google-api-key"
# GOOGLE_API_KEY_10 = "your-tenth-google-api-key"
